// Helper function: Calculate Digital Root
function getDigitalRoot(n) {
  if (n === 0) return 0;
  return 1 + ((n - 1) % 9);
}

// Helper function: Calculate Demon Net-Span Properties
function getNetSpanProps(zoneA, zoneB) {
  const valuation = Math.abs(zoneA - zoneB);
  const plex = getDigitalRoot(zoneA + zoneB);
  return { span: `${zoneA}::${zoneB}`, valuation, plex };
}
